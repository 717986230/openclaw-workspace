{
  "todo": {
    "autoTrack": true,
    "showProgress": true,
    "archiveOnComplete": true,
    "maxActiveTasks": 10
  },
  "ask": {
    "timeout": 300000,
    "defaultConfirm": false,
    "rememberChoice": false
  },
  "worktree": {
